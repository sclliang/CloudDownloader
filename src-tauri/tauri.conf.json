{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudDownloader",
  "mainBinaryName": "CloudDownloader",
  "version": "0.5.7",
  "identifier": "com.sixunited.clouddownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CloudDownloader · 云盘下载器",
        "width": 1180,
        "height": 822,
        "minWidth": 920,
        "minHeight": 682,
        "decorations": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--force-renderer-accessibility",
        "backgroundColor": "#EAF5FC",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "copyright": "Copyright (c) 2026 sixunited. Author: sclliang",
    "resources": {
      "binaries/aria2c-x86_64-pc-windows-msvc.exe": "bin/aria2c.exe",
      "../third-party/notices/*": "bin/notices/",
      "../README.md": "README.md",
      "../VERIFICATION.md": "VERIFICATION.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "sixunited"
  }
}
